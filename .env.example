# Copy this file to .env and fill in your details. Never upload .env to GitHub.
# Numbers can be written any way: 0712 345 678, +254712345678 or 254712345678.

# Your WhatsApp number (the bot owner)
OWNER_NUMBER=0712345678
# Number to link the bot to (leave empty to use OWNER_NUMBER)
PAIRING_NUMBER=
# Country code used for local numbers like 0712... (254 = Kenya)
COUNTRY_CODE=254

OWNER_NAME=Your Name
BOT_NAME=Knight Bot
PACK_NAME=Knight Bot

# Anti-spam: seconds between commands per user (owner and sudo are exempt). 0 turns it off.
COMMAND_COOLDOWN=3

# ---------- Shop (sales & customer care) ----------
SHOP_NAME=My Shop
# M-Pesa: fill in a Till (Buy Goods) and/or a Paybill. Leave MPESA_ACCOUNT empty to use the order number as account.
MPESA_TILL=
MPESA_PAYBILL=
MPESA_ACCOUNT=
# (These are only the starting values; change them later from WhatsApp with .shopset)

# ---------- AI customer assistant (optional) ----------
# Get a key at console.anthropic.com (paid). Without it, the shop still works with menus and FAQs.
ANTHROPIC_API_KEY=
# Model (default claude-opus-5-5). Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Most AI answers per day for the whole shop (cost control)
AI_DAILY_LIMIT=300
