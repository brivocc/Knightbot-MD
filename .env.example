# Copy this file to .env and fill in your details. Never upload .env to GitHub.
# Numbers can be written any way: 0712 345 678, +254712345678 or 254712345678.

# Your WhatsApp number (the bot owner)
OWNER_NUMBER=0712345678
# Number to link the bot to (leave empty to use OWNER_NUMBER)
PAIRING_NUMBER=
# Country code used for local numbers like 0712... (254 = Kenya)
COUNTRY_CODE=254

OWNER_NAME=Your Name
BOT_NAME=Knight Bot
PACK_NAME=Knight Bot

# Anti-spam: seconds between commands per user (owner and sudo are exempt). 0 turns it off.
COMMAND_COOLDOWN=3
